# Copy this file to .env for local development.
# Never commit real credentials, tokens, account IDs, private endpoints, or secrets.

############################
# Application
############################

APP_ENV=development
APP_NAME=movie-recommendation
APP_TITLE=Movie Recommendation API
APP_VERSION=1.0.0
APP_DESCRIPTION=Production-ready FastAPI backend for movie browsing and authentication
DEBUG=False

############################
# API and CORS
############################

API_PREFIX=/api/v1
API_DOCS_PATH=/docs
API_HEALTH_PATH=/health
# Development may use *. Production must use comma-separated HTTPS origins,
# for example: https://movies.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=True

############################
# Logging
############################

LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s %(levelname)s %(name)s %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S

############################
# Authentication
############################

# Required. Generate at least 32 random bytes independently per environment.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=movie-recommendation-api
JWT_AUDIENCE=movie-recommendation-frontend
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_HASH_ITERATIONS=10000

# Development only. Never enable in production.
ALLOW_LEGACY_DEV_LOGIN=False

############################
# AWS SDK
############################

# Required. AWS_REGION is the application setting; AWS_DEFAULT_REGION keeps
# AWS CLI/SDK tooling consistent and should contain the same value.
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1

# Fill only the credential method used by this environment. Blank placeholders
# are normalized by the backend so boto3 can still use ~/.aws, AWS SSO,
# ECS/EC2 credentials, or an IAM role.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional endpoint for an explicitly configured local AWS emulator.
AWS_ENDPOINT_URL=
AWS_VALIDATE_CREDENTIALS=True
AWS_VALIDATE_RESOURCES=True
AWS_CONNECT_TIMEOUT_SECONDS=3
AWS_READ_TIMEOUT_SECONDS=10
AWS_MAX_ATTEMPTS=3
AWS_RETRY_MODE=standard

############################
# DynamoDB - required
############################

AWS_DYNAMODB_MOVIES_TABLE=movie-rec-dev-Movies
AWS_DYNAMODB_POPULAR_TABLE=movie-rec-dev-PopularMovies
AWS_DYNAMODB_USERS_TABLE=movie-rec-dev-Users
AWS_DYNAMODB_INTERACTIONS_TABLE=movie-rec-dev-UserInteractions
AWS_DYNAMODB_RECOMMENDATION_CACHE_TABLE=movie-rec-dev-RecommendationCache

# Existing list_id used for the guest home ranking.
AWS_DYNAMODB_POPULAR_LIST_ID=top_rated_all

############################
# Amazon S3
############################

# Canonical bucket layout. Feature tables intentionally share
# datasets/processed/; AWS_S3_SERVING_PREFIX means ML inference lookups, while
# DynamoDB exports live below AWS_S3_DATASET_PREFIX at datasets/serving/.
AWS_S3_BUCKET=movie-recommendation-fcaj
AWS_S3_DATASET_PREFIX=datasets/
AWS_S3_RAW_PREFIX=datasets/raw/
AWS_S3_PROCESSED_PREFIX=datasets/processed/
AWS_S3_SERVING_PREFIX=inference/
AWS_S3_TRAINING_PREFIX=training/
AWS_S3_MODEL_PREFIX=models/
AWS_S3_OUTPUT_PREFIX=evaluation/
AWS_S3_INTERACTION_EXPORT_PREFIX=datasets/exports/

############################
# SageMaker
############################

# Runtime inference configuration. Training/deployment settings belong to the
# ML tooling and are intentionally not loaded by the FastAPI backend.
AWS_SAGEMAKER_ENABLED=True
AWS_SAGEMAKER_ENDPOINT_NAME=movie-rec-endpoint
AWS_SAGEMAKER_CONTENT_TYPE=application/json
AWS_SAGEMAKER_ACCEPT=application/json
AWS_SAGEMAKER_RECOMMENDATION_LIMIT=10

############################
# Recommendation cache
############################

RECOMMENDATION_CACHE_TTL_SECONDS=300
# Fallback only when the endpoint omits model_version. The deployed
# RecommendationEngine returns its own version, which always takes precedence.
# Never use mock-v1 for real endpoint results.
RECOMMENDATION_MODEL_VERSION=1.0.0

############################
# Frontend / Vite
############################

VITE_API_URL=http://127.0.0.1:8000/api/v1
VITE_TMDB_POSTER_BASE_URL=https://image.tmdb.org/t/p/w500
VITE_HOST=0.0.0.0
VITE_PORT=5173

############################
# Docker Compose
############################

COMPOSE_PROJECT_NAME=movie-recommendation
ENV_FILE=.env

BACKEND_CONTAINER_NAME=movie-backend
BACKEND_HOST=0.0.0.0
BACKEND_HOST_PORT=8000
BACKEND_CONTAINER_PORT=8000
BACKEND_RELOAD=false

FRONTEND_CONTAINER_NAME=movie-frontend
FRONTEND_HOST_PORT=5173
FRONTEND_CONTAINER_PORT=5173

HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=5
