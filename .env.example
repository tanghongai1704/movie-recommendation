############################
# Frontend
############################

VITE_API_URL=http://127.0.0.1:8000/api/v1
VITE_TMDB_POSTER_BASE_URL=https://image.tmdb.org/t/p/w500


############################
# Backend
############################

LOG_LEVEL=INFO
DEBUG=False

# Required. Generate at least 32 random bytes for each environment.
JWT_SECRET=
JWT_ISSUER=movie-recommendation-api
JWT_AUDIENCE=movie-recommendation-frontend
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_HASH_ITERATIONS=10000
# Development only. Accept deterministic schema-v2 seed credentials that
# were stored as <user_id>#pass instead of PBKDF2.
ALLOW_LEGACY_DEV_LOGIN=False

############################
# AWS
############################

AWS_REGION=ap-southeast-1

AWS_ACCESS_KEY_ID=

AWS_SECRET_ACCESS_KEY=

AWS_DYNAMODB_TABLE_MOVIES=

AWS_DYNAMODB_TABLE_USERS=

AWS_DYNAMODB_TABLE_INTERACTIONS=

AWS_DYNAMODB_TABLE_POPULAR=

AWS_DYNAMODB_TABLE_RECOMMENDATION_CACHE=

# Recommendation cache validity window in seconds
RECOMMENDATION_CACHE_TTL_SECONDS=300

AWS_S3_BUCKET=
