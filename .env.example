# Copy this file to .env for local development.
# Never commit real credentials, tokens, account IDs, private endpoints, or secrets.

############################
# Application
############################

APP_ENV=development
APP_NAME=movie-recommendation
APP_TITLE=Movie Recommendation API
APP_VERSION=1.0.0
APP_DESCRIPTION=Production-ready FastAPI backend for movie browsing and authentication
DEBUG=False

############################
# API and CORS
############################

API_PREFIX=/api/v1
API_DOCS_PATH=/docs
API_HEALTH_PATH=/health
# Development may use *. Production must use comma-separated HTTPS origins,
# for example: https://movies.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=True

############################
# Logging
############################

LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s %(levelname)s %(name)s %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S

############################
# Authentication
############################

# Required. Generate at least 32 random bytes independently per environment.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=movie-recommendation-api
JWT_AUDIENCE=movie-recommendation-frontend
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_HASH_ITERATIONS=10000

# Development only. Never enable in production.
ALLOW_LEGACY_DEV_LOGIN=False

############################
# AWS SDK
############################

# Required. AWS_REGION is the application setting; AWS_DEFAULT_REGION keeps
# AWS CLI/SDK tooling consistent and should contain the same value.
AWS_REGION=
AWS_DEFAULT_REGION=

# Optional local profile. Deployed environments should use an IAM role or
# workload identity instead.
AWS_PROFILE=

# Optional local credentials. Prefer AWS SSO/profile locally and IAM roles in
# deployed environments. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional endpoint for an explicitly configured local AWS emulator.
AWS_ENDPOINT_URL=
AWS_VALIDATE_CREDENTIALS=True
AWS_VALIDATE_RESOURCES=True
AWS_CONNECT_TIMEOUT_SECONDS=3
AWS_READ_TIMEOUT_SECONDS=10
AWS_MAX_ATTEMPTS=3
AWS_RETRY_MODE=standard

############################
# DynamoDB - required
############################

AWS_DYNAMODB_MOVIES_TABLE=
AWS_DYNAMODB_POPULAR_TABLE=
AWS_DYNAMODB_USERS_TABLE=
AWS_DYNAMODB_INTERACTIONS_TABLE=
AWS_DYNAMODB_RECOMMENDATION_CACHE_TABLE=

# Existing list_id used for the guest home ranking.
AWS_DYNAMODB_POPULAR_LIST_ID=

############################
# Amazon S3
############################

# Bucket and every prefix are validated at backend startup. Dataset objects are
# consumed by data/training jobs, never by backend request handlers.
AWS_S3_BUCKET=
AWS_S3_DATASET_PREFIX=
AWS_S3_RAW_PREFIX=
AWS_S3_PROCESSED_PREFIX=
AWS_S3_FEATURES_PREFIX=
AWS_S3_SERVING_PREFIX=
AWS_S3_TRAINING_PREFIX=
AWS_S3_MODEL_PREFIX=
AWS_S3_OUTPUT_PREFIX=
AWS_S3_INTERACTION_EXPORT_PREFIX=

############################
# SageMaker
############################

# Set true after a compatible endpoint is deployed. For backward compatibility,
# a non-empty endpoint name also enables inference when this flag is omitted.
# Cache hits continue to work while disabled; cache misses return 503.
AWS_SAGEMAKER_ENABLED=False
AWS_SAGEMAKER_TRAINING_JOB_NAME_PREFIX=
AWS_SAGEMAKER_ENDPOINT_NAME=
AWS_SAGEMAKER_MODEL_NAME=
AWS_SAGEMAKER_EXECUTION_ROLE=
AWS_SAGEMAKER_INSTANCE_TYPE=
AWS_SAGEMAKER_CONTENT_TYPE=application/json
AWS_SAGEMAKER_ACCEPT=application/json
AWS_SAGEMAKER_RECOMMENDATION_LIMIT=10

############################
# Recommendation cache
############################

RECOMMENDATION_CACHE_TTL_SECONDS=300
# Legacy compatibility setting. Runtime cache keys are selected dynamically as
# onboarding_user or returning_user and do not use this value.
RECOMMENDATION_CACHE_SCENARIO=default
# Fallback only when the endpoint omits model_version. The deployed
# RecommendationEngine returns its own version, which always takes precedence.
# Never use mock-v1 for real endpoint results.
RECOMMENDATION_MODEL_VERSION=

############################
# Frontend / Vite
############################

VITE_API_URL=http://127.0.0.1:8000/api/v1
VITE_TMDB_POSTER_BASE_URL=https://image.tmdb.org/t/p/w500
VITE_HOST=0.0.0.0
VITE_PORT=5173

############################
# Docker Compose
############################

COMPOSE_PROJECT_NAME=movie-recommendation
ENV_FILE=.env

BACKEND_CONTAINER_NAME=movie-backend
BACKEND_HOST=0.0.0.0
BACKEND_HOST_PORT=8000
BACKEND_CONTAINER_PORT=8000
BACKEND_RELOAD=false

FRONTEND_CONTAINER_NAME=movie-frontend
FRONTEND_HOST_PORT=5173
FRONTEND_CONTAINER_PORT=5173

HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=5
